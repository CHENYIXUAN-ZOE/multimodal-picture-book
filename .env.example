# Kimi API is disabled by default. Copy this file to .env.local only when ready.
AI_CALLS_ENABLED=false
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Cost guards
DAILY_AI_CALL_LIMIT=20
MAX_CONCURRENT_AI_CALLS=1
MAX_AI_RETRIES=0

# Local-only services
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=43120
LOCAL_API_URL=http://127.0.0.1:43120

# Reserved audio provider slot — intentionally disabled.
AUDIO_PROVIDER=disabled

# Netlify private demo only. Configure these in the Netlify UI, never here.
PROTECTED_PAGE_PASSWORD=
KIMI_REGION=cn
KIMI_DAILY_LIMIT=12
