{
  "name": "multimodal-picture-book",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,LOCAL_API -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "concurrently -k -n WEB,LOCAL_API -c cyan,magenta \"npm:start:web\" \"npm:start:api\"",
    "start:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:api": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "seed:subjects": "tsx scripts/build-subject-seed.ts",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "lucide-react": "^1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "concurrently": "^10.0.4",
    "eslint": "9.39.4",
    "globals": "^14.0.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0"
  },
  "type": "module"
}
